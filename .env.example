# 复制为 .env 后填写；.env 已被 .gitignore 忽略
OPENAI_API_KEY=your-api-key
# 火山引擎 Ark（示例）
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# JUDGE_MODEL=doubao-seed-2-0-code-preview-260215
# 任意 OpenAI 兼容接口
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# JUDGE_MODEL=deepseek-chat

# 可选：配置后答案相关性改用 embedding 余弦相似度
# EMBEDDING_MODEL=text-embedding-3-small

# 并发与重试
MAX_CONCURRENCY=5
REQUEST_TIMEOUT=60
MAX_RETRIES=3
JSON_MODE=1

# 可选：成本估算单价（元 / 百万 token）
# PRICE_INPUT_PER_1M=0.8
# PRICE_OUTPUT_PER_1M=2.0
